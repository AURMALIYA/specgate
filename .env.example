# SpecGate API/dashboard configuration. Copy to .env and fill in.
# Everything has a safe default; the platform runs fully offline with none of these set.

# --- Core ---
SPECGATE_CONFIG=config/default.config.yaml   # org governance config (YAML)
PORT=8787
DASHBOARD_DIR=apps/dashboard/public

# --- Durable persistence (audit log + RBAC config). Unset = in-memory. ---
# Specs/registry are re-ingested from git (source of truth); the durable state is
# the override audit log and the project/role config.
SPECGATE_DATA_DIR=./.specgate-data

# --- RBAC / identity ---
SPECGATE_AUTH=off                 # 'on' enforces roles on privileged endpoints
SPECGATE_IDENTITY=static          # 'github' to derive roles from repo permissions

# --- Co-author / semantic (optional; offline fallbacks exist) ---
# ANTHROPIC_API_KEY=sk-ant-...     # enables the model-backed co-author + semantic layer

# --- Dispatch ("Run") ---
SPECGATE_TARGET=dry-run           # dry-run | git | replit
SPECGATE_REPO=owner/name          # target repo for git-handoff / Replit import
# GITHUB_TOKEN=ghp_...             # needed for git-handoff, PR comments, and merge
# REPLIT_API_TOKEN=...             # live Replit kicker (dry-run returns the import URL otherwise)
# REPLIT_API_URL=...               # your Replit start-workspace endpoint

# --- Hardening ---
SPECGATE_RATE_LIMIT=120           # requests/min per credential or address (unset = no limit)
